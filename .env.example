# TouchDesigner MCP Server — environment variables (copy to .env; .env is
# git-ignored because TD_MCP_TOKEN is a secret).
#
# NOTE: the server does NOT auto-load .env (no dotenv dependency) — it reads
# plain process.env. Provide these via your MCP client config's "env" block,
# your shell (set -a; source .env; set +a), or your cloud environment settings.
#
# All 21 knowledge tools work with NOTHING set. These three only matter for
# the 18 live-control td_* tools that reach a running TouchDesigner bridge.

# Shared secret printed by td-bridge/bootstrap.py when the bridge starts
# inside TouchDesigner. Required for any live-control call.
TD_MCP_TOKEN=

# Host of the running TouchDesigner bridge.
#   TD on this machine        -> 127.0.0.1
#   cloud container -> local TD: a tunnel host (Tailscale/ngrok/SSH), NOT
#   127.0.0.1 (that is the container itself).
TD_MCP_HOST=127.0.0.1

# Bridge port (the Web Server DAT created by bootstrap.py).
TD_MCP_PORT=9981

# Optional: per-request timeout in ms (default 8000; td_render uses 20000).
# Raise if heavy networks make commands time out with "TD may be busy".
#TD_MCP_TIMEOUT_MS=8000

# Optional: verbose server-side debug logging (full Python class list at boot).
#TD_MCP_DEBUG=1
